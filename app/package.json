{
  "name": "app",
  "version": "1.0.0",
  "main": "index.js",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.21",
    "expo-auth-session": "~58.0.16",
    "expo-blur": "~58.0.5",
    "expo-camera": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-haptics": "~58.0.7",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-location": "~58.0.20",
    "expo-status-bar": "~58.0.4",
    "expo-video": "~58.0.13",
    "expo-web-browser": "~58.0.7",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-worklets": "0.13.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-svg": "15.16.0"
  },
  "devDependencies": {
    "@expo/metro-config": "~58.0.19",
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.22",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "sync:icons": "node scripts/sync-icons.js",
    "prestart": "node scripts/sync-icons.js",
    "start": "expo start --clear",
    "iphone": "expo start --go --tunnel --clear",
    "iphone:clear": "expo start --go --tunnel --clear",
    "iphone:ngrok": "expo start --go --tunnel ngrok",
    "prebuild": "node scripts/sync-icons.js && expo prebuild --clean",
    "prebuild:ios": "node scripts/sync-icons.js && expo prebuild --platform ios --clean",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:ios": "expo run:ios --configuration Release",
    "web": "expo start --web"
  },
  "private": true
